[Unit]
Description=Todo manager server (Drogon)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/todo_server --host 0.0.0.0 --port 27183 \
    --data %h/.local/share/todo_manager/todos.json \
    --web %h/.local/share/todo_manager/public
WorkingDirectory=%h/.local/share/todo_manager
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
